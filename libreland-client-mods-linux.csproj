<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>LibrelandClient</AssemblyName>
    <Description>A client mod for Libreland</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10</LangVersion>

    <!-- This prevents the compiler from adding default usings, which is good for mod projects -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- This section automatically finds your game folder on different systems -->
  <PropertyGroup>
    <GamePath>$(MSBuildThisFileDirectory)Anyland</GamePath>
    <GamePath Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Anyland\')">C:\Program Files (x86)\Steam\steamapps\common\Anyland\</GamePath>
    <GamePath Condition="Exists('$(HOME)/Downloads/Echoland Client/')">$(HOME)/Downloads/Echoland Client/</GamePath>
    <!-- Add other common paths here if needed -->
  </PropertyGroup>

  <!-- This will print the detected GamePath when you build, which is great for debugging! -->
  <Target Name="LogInfo" BeforeTargets="PrepareForBuild">
    <Message Text="GamePath detected as: $(GamePath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- BepInEx and Harmony References. Note the forward slashes for cross-platform compatibility. -->
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/BepInEx/core/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GamePath)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(GamePath)/BepInEx/core/BepInEx.Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity and Game References -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamePath)/anyland_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GamePath)/anyland_Data/Managed/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GamePath)/anyland_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GamePath)/anyland_Data/Managed/PhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Core .NET Framework References -->
    <Reference Include="mscorlib">
      <HintPath>$(GamePath)/anyland_Data/Managed/mscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(GamePath)/anyland_Data/Managed/System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GamePath)/anyland_Data/Managed/System.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- This copies your mod DLL to the game's plugin folder automatically after a successful build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Message Text="Attempting to copy $(TargetFileName) to $(GamePath)/BepInEx/plugins" Importance="high" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(GamePath)/BepInEx/plugins" ContinueOnError="true" />
  </Target>

</Project>